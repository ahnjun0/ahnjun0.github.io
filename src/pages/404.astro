---
import Base from "../layouts/Base.astro";
import { ui } from "../i18n";
---
<Base title="404">
  <div class="wrap" style="padding-block:120px 160px">
    <p class="mono">404</p>
    <h1 style="font-size:40px;font-weight:800;letter-spacing:-.03em;margin:8px 0 12px">{ui.ko.notFound} <span style="color:var(--mute);font-weight:500;font-size:22px">/ {ui.en.notFound}</span></h1>
    <a class="more" href="/">{ui.ko.home}</a> &nbsp; <a class="more" href="/en/">{ui.en.home}</a>
  </div>
</Base>
