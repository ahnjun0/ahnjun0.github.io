---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
export async function getStaticPaths() {
  const all = await getCollection("projects", ({ data }) => !data.draft);
  return all.map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
const d = p.data;
const { Content } = await render(p);
---
<Base title={d.title} description={d.summary} current="projects">
  <article class="article">
    <a class="back" href="/projects">← Projects</a>
    <div class="eyebrow">{d.category} · {d.period}</div>
    <h1>{d.title}</h1>
    <p class="lede">{d.summary}</p>
    <div class="facts">
      {d.role && <div><b>ROLE</b>{d.role}</div>}
      {d.result && <div><b>RESULT</b>{d.result}</div>}
      <div><b>STACK</b>{d.tags.join(" · ")}</div>
      {(d.repo || d.link) && <div><b>LINKS</b>{d.repo && <a href={d.repo} target="_blank" rel="noopener">Repository</a>}{d.repo && d.link && " · "}{d.link && <a href={d.link} target="_blank" rel="noopener">Site</a>}</div>}
    </div>
    <div class="prose"><Content /></div>
  </article>
</Base>
