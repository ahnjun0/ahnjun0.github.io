---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { repoMeta } from "../../lib/github";
export async function getStaticPaths() {
  const all = await getCollection("projects", ({ data }) => !data.draft);
  return all.map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
const d = p.data;
const { Content } = await render(p);
const meta = d.repo ? await repoMeta(d.repo) : null;
const repoOk = !!(d.repo && meta);
---
<Base title={d.title} description={d.summary} current="projects">
  <article class="article">
    <a class="back" href="/projects">← Projects</a>
    <div class="eyebrow">{d.category} · {d.period}</div>
    <h1>{d.title}</h1>
    <p class="lede">{d.summary}</p>
    <div class="facts">
      {d.role && <div><b>ROLE</b>{d.role}</div>}
      {d.result && <div><b>RESULT</b>{d.result}</div>}
      <div><b>STACK</b>{d.tags.join(" · ")}</div>
      {(repoOk || d.link) && <div><b>LINKS</b>{repoOk && <a href={d.repo} target="_blank" rel="noopener">Repository</a>}{repoOk && d.link && " · "}{d.link && <a href={d.link} target="_blank" rel="noopener">Site</a>}</div>}
      {repoOk && meta && <div><b>GITHUB</b>{meta.language && `${meta.language} · `}{meta.stars > 0 && `★ ${meta.stars} · `}마지막 커밋 {meta.pushedAt}</div>}
    </div>
    <div class="prose"><Content /></div>
  </article>
</Base>
