---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
const all = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => b.data.sortDate.localeCompare(a.data.sortDate));
const cats = [...new Set(all.map((p) => p.data.category))];
---
<Base title="Projects" current="projects">
  <div class="wrap page">
    <h1>Projects <small>{all.length}</small></h1>
    <p class="intro">대회, 캠프, 동아리, 혼자 만든 것까지. 각 페이지는 <b>문제 → 접근 → 결과 → 배운 점</b> 순서로 씁니다.</p>
    <div class="filters" id="filters">
      <a href="#" data-cat="" aria-current="true">전체</a>
      {cats.map((c) => <a href="#" data-cat={c}>{c}</a>)}
    </div>
    <div class="list">
      {all.map((p) => (
        <a href={`/projects/${p.id}`} data-cat={p.data.category}>
          <span class="ld">{p.data.period}</span>
          <span><span class="lt">{p.data.title}</span><span class="ls">{p.data.summary}</span></span>
          <span class="lr">{p.data.result ?? p.data.category}</span>
        </a>
      ))}
    </div>
  </div>
</Base>
<style>
  .page { padding-block: 64px 96px; }
  h1 { font-size: clamp(32px, 4.4vw, 44px); font-weight: 800; letter-spacing: -0.035em; margin: 0 0 10px; }
  h1 small { font-family: var(--mono); font-size: 14px; font-weight: 400; color: var(--mute); margin-left: 8px; }
  .intro { color: var(--ink2); margin: 0 0 28px; max-width: 60ch; }
  .intro b { color: var(--ink); font-weight: 600; }
</style>
<script>
  const links = document.querySelectorAll<HTMLAnchorElement>("#filters a");
  const rows = document.querySelectorAll<HTMLAnchorElement>(".list a");
  links.forEach((l) => l.addEventListener("click", (e) => {
    e.preventDefault();
    const cat = l.dataset.cat ?? "";
    links.forEach((x) => x.removeAttribute("aria-current"));
    l.setAttribute("aria-current", "true");
    rows.forEach((r) => { r.hidden = !!cat && r.dataset.cat !== cat; });
  }));
</script>
