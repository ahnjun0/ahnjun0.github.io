---
import type { CollectionEntry } from "astro:content";
import { prefix, type Lang } from "../i18n";
interface Props { project: CollectionEntry<"projects"> | CollectionEntry<"projectsEn">; index?: number; lang?: Lang; }
const { project, index, lang = "ko" } = Astro.props;
const d = project.data;
const n = index !== undefined ? String(index + 1).padStart(2, "0") + " · " : "";
---
<a class="card" href={`${prefix(lang)}/projects/${project.id}`}>
  <span class="n">{n}{d.period}</span>
  <h3>{d.title}</h3>
  <p>{d.summary}</p>
  <div class="meta">
    {d.result && <span class="r">{d.result}</span>}
    <span class="t">{d.tags.join(" · ")}</span>
  </div>
  <span class="arrow" aria-hidden="true">↗</span>
</a>
