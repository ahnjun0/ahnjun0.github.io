---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { prefix, ui, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const coll = lang === "en" ? "projectsEn" : "projects";
const all = (await getCollection(coll, ({ data }) => !data.draft)).sort((a, b) => b.data.sortDate.localeCompare(a.data.sortDate));
const cats = [...new Set(all.map((p) => p.data.category))];
---
<Base title={t.nav.projects} current="projects" lang={lang}>
  <div class="wrap page">
    <h1>{t.nav.projects} <small>{all.length}</small></h1>
    <p class="intro" set:html={t.projectsIntro} />
    <div class="filters" id="filters" role="group" aria-label={t.filterLabel}>
      <button type="button" data-cat="" aria-pressed="true">{t.filterAll}</button>
      {cats.map((c) => <button type="button" data-cat={c} aria-pressed="false">{c}</button>)}
    </div>
    <p class="sr-only" id="filter-status" aria-live="polite" data-tpl={t.filterStatus}></p>
    <ul class="list">
      {all.map((p) => (
        <li data-cat={p.data.category}>
          <a href={`${prefix(lang)}/projects/${p.id}`}>
            <span class="ld">{p.data.period}</span>
            <span><span class="lt">{p.data.title}</span><span class="ls">{p.data.summary}</span></span>
            <span class="lr">{p.data.result ?? p.data.category}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
<style>
  .page { padding-block: 64px 96px; }
  h1 { font-size: clamp(32px, 4.4vw, 44px); font-weight: 800; letter-spacing: -0.035em; margin: 0 0 10px; }
  h1 small { font-family: var(--mono); font-size: 14px; font-weight: 400; color: var(--mute); margin-left: 8px; }
  .intro { color: var(--ink2); margin: 0 0 28px; max-width: 60ch; }
  .intro :global(b) { color: var(--ink); font-weight: 600; }
</style>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("#filters button");
  const rows = document.querySelectorAll<HTMLLIElement>(".list li");
  const status = document.getElementById("filter-status")!;
  buttons.forEach((b) => b.addEventListener("click", () => {
    const cat = b.dataset.cat ?? "";
    buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    let shown = 0;
    rows.forEach((r) => { r.hidden = !!cat && r.dataset.cat !== cat; if (!r.hidden) shown++; });
    status.textContent = status.dataset.tpl!.replace("{n}", String(shown));
  }));
</script>
